      "value": "20",
      "dynamicValue": true,
      "field": "claimsFreeYears"
    },
    {
      "method": "clickElement",
      "selector": "//button[@class='p-element p-ripple p-datepicker-trigger ng-tns-c3108139663-9 p-button p-component p-button-icon-only ng-star-inserted']"
    },
    { "method": "explicitWait", "ms": 500 },
    {
      "method": "clickElement",
      "selector": "//button[text()=' * ']",
      "dynamicValue": true,
      "field": "year"
